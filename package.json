{
  "name": "ramiro-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/adapter.js --bundle --minify --format=iife --target=es2019 --outfile=public/js/firebase-adapter.js",
    "importar": "node scripts/importar.mjs",
    "probar": "firebase emulators:start --project demo-ramiro",
    "publicar": "npm run build && npm run version && npm run calendario && firebase deploy --only hosting",
    "version": "node scripts/version.mjs",
    "calendario": "node scripts/calendario.mjs"
  },
  "dependencies": {
    "firebase": "13.0.0"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "firebase-admin": "13.5.0"
  }
}
